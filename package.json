    "test": "node --test test/unit.test.mjs",
    "test:e2e": "node --test test/unit.test.mjs test/launcher.e2e.test.mjs test/plugins.e2e.test.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sandbox",
    "windows",
    "killswitch",
    "agents",
    "security"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
